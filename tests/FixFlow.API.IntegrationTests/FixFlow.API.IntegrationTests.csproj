<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The containers use the image tags and the init script from Compose (Fixtures/TestInfrastructure.cs) -->
  <ItemGroup>
    <None Include="..\..\docker-compose.yml" Link="Compose\docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docker\postgres\initdb\*.sh" Link="Compose\initdb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A stand-in for the SPA the image copies into wwwroot (Hosting/SpaHostingTests.cs) -->
  <ItemGroup>
    <None Update="Hosting\TestWebRoot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NodaTime.Testing" />
    <!-- The generic container builder, for Mailpit (Fixtures/TestInfrastructure.cs) -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FixFlow.API\FixFlow.API.csproj" />
    <ProjectReference Include="..\..\src\FixFlow.Contracts\FixFlow.Contracts.csproj" />
  </ItemGroup>

</Project>
