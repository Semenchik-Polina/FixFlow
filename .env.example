# Docker Compose variables for local development.
# Copy to `.env` (untracked) and replace every value. Never commit `.env`.
# Use local-only throwaway values; this stack is bound to 127.0.0.1.

# PostgreSQL superuser (used only by the container and the init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Application database and least-privilege role (created by the init script, S22)
FIXFLOW_DB_NAME=fixflow
FIXFLOW_DB_USER=fixflow_app
FIXFLOW_DB_PASSWORD=change-me

# Seq admin password for the first run
SEQ_FIRSTRUN_ADMINPASSWORD=change-me

# Optional: a Seq API key with the Ingest permission for the `full` profile's API container
# (the API on the host reads its key from user-secrets instead)
SEQ_API_KEY=
