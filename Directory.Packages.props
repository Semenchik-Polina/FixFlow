<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Sensitive" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <PackageVersion Include="AspNetCore.HealthChecks.Azure.Storage.Blobs" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
  </ItemGroup>

  <!-- Used directly by Hosting (BlobServiceClient) and API (NpgsqlConnectionStringBuilder). The health checks
       pull in older versions. Keep these in step with Infrastructure: Npgsql with the version
       Npgsql.EntityFrameworkCore.PostgreSQL requires, Azure.Storage.Blobs (T4.x). -->
  <ItemGroup Label="Data and storage clients">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- EF Core on the same servicing release as the ASP.NET Core packages. Relational is pinned too, so the provider
       can't pull an older one than EF Core itself. -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.0.3" />
  </ItemGroup>

  <!-- Same servicing release as EF Core: the EF stores pull EF Core Relational, which is pinned above -->
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.12" />
  </ItemGroup>

  <!-- SMTP (plan A12). The API gets ValidateDataAnnotations from the shared framework; Infrastructure, which checks
       SmtpOptions, needs the package: keep it on the Microsoft.Extensions.Options version EF Core brings. -->
  <ItemGroup Label="Email">
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
  </ItemGroup>

  <!-- HybridCache, in-process only until Phase 2 adds Redis (plan A7). Its abstraction comes with
       Microsoft.Extensions.Caching.Abstractions, which EF Core brings: keep this on the release that depends on EF
       Core's servicing version. -->
  <ItemGroup Label="Caching">
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
  </ItemGroup>

  <!-- The app's IClock (T0.8) and the tests' FakeClock must come from the same NodaTime -->
  <ItemGroup Label="Time">
    <PackageVersion Include="NodaTime" Version="3.3.6" />
    <PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
  </ItemGroup>

  <!-- MediatR stays on the Apache-2.0 12.x line (ADR 0004) -->
  <ItemGroup Label="Application">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <!-- Keep in step with Microsoft.AspNetCore.Mvc.Testing -->
  <ItemGroup Label="OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NodaTime.Testing" Version="3.3.6" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>

</Project>
